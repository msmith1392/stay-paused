{
  "manifest_version": 3,
  "name": "Stay Paused",
  "short_name": "Stay Paused",
  "version": "1.0.0",
  "description": "Stop videos from autoplaying when you switch to a tab. Media waits until you click.",
  "homepage_url": "https://github.com/msmith1392/stay-paused",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Stay Paused",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": ["<all_urls>"]
}
